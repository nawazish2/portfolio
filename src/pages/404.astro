---
import Base from "@/layouts/Base.astro";
import Header from "@/components/Header.astro";
---

<Base title="Not found" description="This page does not exist." path="/404">
  <Header />
  <main class="mx-auto flex min-h-[70vh] max-w-md flex-col items-center justify-center px-4 text-center">
    <h1 class="text-3xl font-bold tracking-tight text-text">Page not found</h1>
    <p class="mt-2 text-text-soft">That link doesn't go anywhere.</p>
    <a href="/" class="btn btn-ghost mt-6">Back home</a>
  </main>
</Base>
