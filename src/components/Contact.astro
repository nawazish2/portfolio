---
import { siteConfig } from "@/content/site";
import ContactForm from "@/components/ContactForm.astro";
---

<section id="contact" class="scroll-mt-20">
  <div class="card p-5 sm:p-7">
    <h2 class="text-[1.375rem] font-bold tracking-tight">Let's talk</h2>
    <p class="mt-1 text-[15px] text-ink-soft">
      Open to SDE roles, internships and product work. Or email me at{" "}
      <a href={siteConfig.links.email} class="font-medium text-accent-ink underline">{siteConfig.email}</a>.
    </p>
    <div class="mt-4 flex flex-wrap gap-2">
      <a href={siteConfig.links.email} class="btn btn-primary">Email me</a>
      <a href={siteConfig.links.linkedin} target="_blank" rel="noopener noreferrer" class="btn btn-chip">LinkedIn</a>
    </div>
    <p class="mt-5 text-xs font-semibold tracking-wide text-ink-faint uppercase">Or send a message</p>
    <div class="mt-2">
      <ContactForm />
    </div>
  </div>
</section>
