---
import Icon from "@/components/Icon.astro";
import type { Project } from "@/content/projects";

interface Props {
  project: Project;
  tone?: "page" | "card";
}
const { project, tone = "page" } = Astro.props;
const isDownload = project.live?.includes("github.com");
const secondary = tone === "page" ? "btn btn-ghost" : "btn btn-chip";
---

<div class="flex flex-wrap gap-2.5">
  {
    project.live ? (
      <a
        href={project.live}
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-primary pr-3.5 pl-4"
        aria-label={`${isDownload ? "Download" : "Open"} ${project.title}`}
      >
        {isDownload ? "Download" : "Live site"}
        <Icon name="arrow-up-right" size={16} strokeWidth={2.25} class="btn-arrow" />
      </a>
    ) : null
  }
  {
    project.github ? (
      <a
        href={project.github}
        target="_blank"
        rel="noopener noreferrer"
        class:list={[secondary, "pr-4 pl-3.5"]}
        aria-label={`${project.title} source code on GitHub`}
      >
        <Icon name="github" size={16} strokeWidth={2} />
        Code
      </a>
    ) : null
  }
</div>
