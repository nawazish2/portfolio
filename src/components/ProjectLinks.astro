---
import Icon from "@/components/Icon.astro";
import type { Project } from "@/content/projects";

interface Props {
  project: Project;
  tone?: "page" | "card";
}
const { project, tone = "page" } = Astro.props;
const isDownload = project.live?.includes("github.com");
const secondary =
  tone === "page"
    ? "btn btn-ghost h-9 px-3.5 text-[13px]"
    : "btn h-9 border border-card-line px-3.5 text-[13px] text-ink hover:bg-card-sunk";
---

<div class="flex flex-wrap gap-2">
  {
    project.live ? (
      <a href={project.live} target="_blank" rel="noopener noreferrer" class="btn btn-primary h-9 px-3.5 text-[13px]">
        {isDownload ? "Download" : "Live site"}
        <Icon name="arrow-up-right" size={14} />
      </a>
    ) : null
  }
  {
    project.github ? (
      <a href={project.github} target="_blank" rel="noopener noreferrer" class={secondary}>
        <Icon name="github" size={14} />
        Code
      </a>
    ) : null
  }
</div>
