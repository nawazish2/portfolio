---
import { siteConfig } from "@/content/site";

const links = [
  { href: siteConfig.links.github, label: "GitHub" },
  { href: siteConfig.links.linkedin, label: "LinkedIn" },
  { href: siteConfig.links.x, label: "X" },
  { href: siteConfig.links.blog, label: "Blog" },
];
---

<footer class="mt-16 border-t border-line py-8 text-sm text-text-soft">
  <div class="flex flex-col items-center justify-between gap-3 sm:flex-row">
    <p>© {new Date().getFullYear()} {siteConfig.name}</p>
    <nav aria-label="Elsewhere" class="-my-2 flex gap-1">
      {
        links.map((link) => (
          <a href={link.href} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-10 min-w-10 items-center justify-center px-2 transition-colors hover:text-text">
            {link.label}
          </a>
        ))
      }
    </nav>
  </div>
</footer>
