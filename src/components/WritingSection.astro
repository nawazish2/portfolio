---
import { siteConfig } from "@/content/site";
import { getWritingPosts } from "@/lib/writing";
import Icon from "@/components/Icon.astro";
import Reveal from "@/components/Reveal.astro";
import Paper from "@/components/desk/Paper.astro";
import MatHeading from "@/components/desk/MatHeading.astro";

const tilts = [-1.3, 0.9, 1.1, -0.8];
const posts = await getWritingPosts(4);
---

<section id="notes" class="scroll-mt-28">
  <Reveal>
    <div class="flex flex-wrap items-end justify-between gap-3">
      <MatHeading hand="from the desk">Writing</MatHeading>
      <a
        href={siteConfig.writing.href}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1 text-[12px] text-on-mat-soft transition hover:text-on-mat"
      >
        {siteConfig.writing.cta}
        <Icon name="arrow-up-right" size={14} />
      </a>
    </div>
    <p class="mt-2.5 max-w-xl text-[13px] leading-relaxed text-on-mat-soft">{siteConfig.writing.description}</p>
  </Reveal>

  {
    posts.length > 0 ? (
      <div class="mt-6 grid gap-5 sm:grid-cols-2">
        {posts.map((post, index) => (
          <Reveal delay={index * 0.05} class="h-full">
            <a
              href={post.href}
              target="_blank"
              rel="noopener noreferrer"
              class="group block h-full transition-transform duration-300 hover:-translate-y-1"
            >
              {/* Ruled index card — the top red line is the giveaway. */}
              <Paper tilt={tilts[index % tilts.length]} class="h-full overflow-hidden">
                <div class="h-8 border-b-2 border-[#e0736f]/45 bg-[linear-gradient(#dfd9c8_1px,transparent_1px)] bg-[length:100%_16px]" />
                <div
                  class="px-4 py-3.5"
                  style="background-image: linear-gradient(#dfd9c8 1px, transparent 1px); background-size: 100% 24px; background-position: 0 20px;"
                >
                  <h3 class="text-[14px] leading-snug font-semibold text-ink group-hover:text-accent-ink">{post.title}</h3>
                  {post.brief ? (
                    <p class="mt-1.5 line-clamp-3 text-[12.5px] leading-[1.65] text-ink-soft">{post.brief}</p>
                  ) : null}
                  <p class="mt-2.5 font-mono text-[10px] text-ink-faint">{post.dateLabel}</p>
                </div>
              </Paper>
            </a>
          </Reveal>
        ))}
      </div>
    ) : (
      <p class="mt-6 font-hand text-[19px] text-on-mat-soft">the latest notes live on Hashnode →</p>
    )
  }
</section>
