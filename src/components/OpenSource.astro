---
import { ossContributions } from "@/content/opensource";
import { formatStars, getOssStars } from "@/lib/oss";
import Icon from "@/components/Icon.astro";

const stars = await getOssStars([...new Set(ossContributions.map((oss) => oss.repo))]);
---

<section id="opensource" class="scroll-mt-20">
  <h2 class="section-title">Open source</h2>
  <p class="mt-1 text-[15px] text-text-soft">Pull requests merged into other people's projects.</p>

  <ul class="card mt-4 divide-y divide-card-line">
    {
      ossContributions.map((oss) => {
        const count = stars[oss.repo];
        return (
          <li>
            <a
              href={oss.prUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="group flex flex-col-reverse items-start gap-1.5 px-4 py-3 transition-colors sm:px-5 sm:py-3.5 hover:bg-card-sunk/60 sm:flex-row sm:justify-between sm:gap-4"
            >
              <div class="min-w-0">
                <p class="text-[15px] leading-snug font-semibold text-ink group-hover:underline">{oss.title}</p>
                <p class="mt-1 text-[14px] leading-snug text-ink-soft">{oss.impact}</p>
                <p class="mt-1 flex flex-wrap items-center gap-x-2 text-[13px] text-ink-faint">
                  <span>{oss.repo}</span>
                  {count != null ? (
                    <span class="inline-flex items-center gap-0.5">
                      <Icon name="star" size={11} />
                      {formatStars(count)}
                    </span>
                  ) : null}
                </p>
              </div>
              <span class="shrink-0 rounded-full bg-emerald-100 px-2 py-0.5 text-xs font-semibold text-emerald-900">
                {oss.pr} {oss.status}
              </span>
            </a>
          </li>
        );
      })
    }
  </ul>
</section>
