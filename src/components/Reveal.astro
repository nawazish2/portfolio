---
/**
 * Fades its content in the first time it scrolls into view. One shared
 * IntersectionObserver (in the base layout) drives every instance; the effect
 * itself is CSS — see `.reveal` in global.css.
 */
interface Props {
  class?: string;
  delay?: number;
}
const { class: className, delay = 0 } = Astro.props;
---

<div class:list={["reveal", className]} style={delay ? `--reveal-delay: ${delay}s` : undefined}>
  <slot />
</div>
