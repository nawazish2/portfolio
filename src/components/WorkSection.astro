---
import { siteConfig } from "@/content/site";
import Paper from "@/components/desk/Paper.astro";
import Tape from "@/components/desk/Tape.astro";
import Reveal from "@/components/Reveal.astro";
import TimelineEntry from "@/components/TimelineEntry.astro";

const { education, building } = siteConfig.timeline;
---

<section id="work" class="scroll-mt-28">
  <Reveal>
    <div class="relative">
      <Tape class="-top-3 left-12 z-10" tilt={-6} />
      <Tape class="-top-3 right-14 z-10" tilt={7} />
      <Paper tilt={0.3} class="px-4 py-4 sm:px-5 sm:py-5">
        <h2 class="text-[21px] leading-none font-semibold tracking-[-0.02em] text-ink sm:text-[24px]">
          Education{" "}
          <span class="font-hand text-[1.08em] leading-none font-normal text-accent">&amp; what I build</span>
        </h2>
        <span aria-hidden="true" class="mt-2.5 block h-0.5 w-14 rounded-full bg-accent/60"></span>

        <p class="mt-3.5 font-mono text-[10px] tracking-[0.16em] text-ink-faint uppercase">Education</p>
        <ul class="mt-2.5">
          {education.map((entry, index) => <TimelineEntry entry={entry} last={index === education.length - 1} />)}
        </ul>

        <p class="mt-5 font-mono text-[10px] tracking-[0.16em] text-ink-faint uppercase">What I've been building</p>
        <ul class="mt-2.5">
          {building.map((entry, index) => <TimelineEntry entry={entry} last={index === building.length - 1} />)}
        </ul>

        <p class="mt-5 border-t border-dashed border-paper-edge pt-3.5 font-hand text-[17px] text-ink-soft">
          no job history yet — that's the point of this page.
        </p>
      </Paper>
    </div>
  </Reveal>
</section>
