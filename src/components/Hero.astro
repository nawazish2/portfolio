---
import { Picture } from "astro:assets";
import { siteConfig } from "@/content/site";
import { localImage } from "@/lib/images";
import Icon, { type IconName } from "@/components/Icon.astro";

const profile = localImage(siteConfig.profileImage)!;

const links: { href: string; label: string; icon: IconName }[] = [
  { href: siteConfig.links.github, label: "GitHub", icon: "github" },
  { href: siteConfig.links.linkedin, label: "LinkedIn", icon: "linkedin" },
  { href: siteConfig.links.email, label: "Email", icon: "mail" },
];
---

<section id="about" class="pt-12 sm:pt-16">
  <Picture
    src={profile}
    alt={siteConfig.name}
    formats={["avif", "webp"]}
    widths={[96, 192]}
    sizes="96px"
    loading="eager"
    fetchpriority="high"
    class="size-20 rounded-full object-cover ring-2 ring-line sm:size-24"
  />

  <h1 class="mt-6 text-3xl font-bold tracking-tight text-text sm:text-4xl">
    Hi, I'm {siteConfig.shortName}.
  </h1>
  <p class="mt-2 text-lg font-medium text-accent">{siteConfig.role} · Swift &amp; TypeScript</p>

  <p class="mt-4 max-w-xl text-base leading-relaxed text-text-soft">{siteConfig.summary}</p>
  <p class="mt-3 text-sm text-text-soft">{siteConfig.educationShort}</p>

  <p class="mt-5 inline-flex items-center gap-2 rounded-full bg-bg-raised px-3 py-1 text-sm text-text">
    <span aria-hidden="true" class="size-2 rounded-full bg-emerald-400"></span>
    {siteConfig.availability}
  </p>

  <div class="mt-6 flex flex-wrap gap-2">
    <a href={siteConfig.resumeUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
      <Icon name="file-text" size={16} />
      Résumé
    </a>
    {
      links.map((link) => (
        <a
          href={link.href}
          target={link.href.startsWith("http") ? "_blank" : undefined}
          rel={link.href.startsWith("http") ? "noopener noreferrer" : undefined}
          class="btn btn-ghost"
        >
          <Icon name={link.icon} size={16} />
          {link.label}
        </a>
      ))
    }
  </div>
</section>
