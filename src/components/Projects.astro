---
import { Picture } from "astro:assets";
import { projects } from "@/content/projects";
import { siteConfig } from "@/content/site";
import { localImage } from "@/lib/images";
import Icon from "@/components/Icon.astro";

const featured = siteConfig.featuredProjects
  .map((slug) => projects.find((project) => project.slug === slug))
  .filter((project) => project !== undefined);
---

<section id="projects" class="scroll-mt-20">
  <h2 class="section-title">Projects</h2>

  <div class="mt-5 grid gap-5">
    {
      featured.map((project, index) => {
        const image = project.image ? localImage(project.image) : undefined;
        return (
          <article class="card overflow-hidden sm:grid sm:grid-cols-[2fr_3fr]">
            {image ? (
              <Picture
                src={image}
                alt={`${project.title} screenshot`}
                formats={["avif", "webp"]}
                widths={[320, 480, 720]}
                sizes="(min-width: 640px) 290px, 100vw"
                loading={index === 0 ? "eager" : "lazy"}
                decoding="async"
                class="aspect-[16/9] h-full w-full bg-card-sunk object-cover sm:aspect-auto"
              />
            ) : null}

            <div class="flex flex-col p-5">
              <div class="flex items-center gap-2">
                <h3 class="text-lg font-semibold tracking-tight">{project.title}</h3>
                <span class="rounded-full bg-card-sunk px-2 py-0.5 text-xs text-ink-soft">{project.status}</span>
              </div>
              <p class="mt-1 text-sm font-medium text-accent-ink">{project.oneLiner}</p>
              <p class="mt-2 text-sm leading-relaxed text-ink-soft">{project.description}</p>

              <p class="mt-3 text-xs text-ink-faint">{project.stack.join(" · ")}</p>

              <div class="-mx-1 mt-2 flex gap-3 text-sm font-semibold">
                {project.live ? (
                  <a href={project.live} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-10 items-center gap-1 px-1 text-accent-ink hover:underline">
                    {project.live.includes("github.com") ? "Download" : "Live site"}
                    <Icon name="arrow-up-right" size={14} />
                  </a>
                ) : null}
                {project.github ? (
                  <a href={project.github} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-10 items-center gap-1 px-1 text-ink-soft hover:text-ink hover:underline">
                    Code
                    <Icon name="arrow-up-right" size={14} />
                  </a>
                ) : null}
              </div>
            </div>
          </article>
        );
      })
    }
  </div>
</section>
