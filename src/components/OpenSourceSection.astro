---
import { ossContributions } from "@/content/opensource";
import { formatStars, getOssStars } from "@/lib/oss";
import Icon from "@/components/Icon.astro";
import Reveal from "@/components/Reveal.astro";
import Paper from "@/components/desk/Paper.astro";
import Pin from "@/components/desk/Pin.astro";
import MatHeading from "@/components/desk/MatHeading.astro";

const tilts = [-1.2, 0.9, 1.1, -0.9, 1.3, -1.1];
const stars = await getOssStars([...new Set(ossContributions.map((oss) => oss.repo))]);
---

<section id="opensource" class="scroll-mt-28">
  <Reveal>
    <div class="flex flex-wrap items-end justify-between gap-3">
      <MatHeading hand="postcards from upstream">Open source</MatHeading>
      <a
        href="https://github.com/nawazish2?tab=repositories"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1 text-[12px] text-on-mat-soft transition hover:text-on-mat"
      >
        More on GitHub
        <Icon name="arrow-up-right" size={14} />
      </a>
    </div>
    <p class="mt-2.5 max-w-xl text-[13px] leading-relaxed text-on-mat-soft">
      Merged PRs in other people's repos — the fastest proof I can read code, scope a fix, and land it.
    </p>
  </Reveal>

  <div class="mt-6 grid gap-5 sm:grid-cols-2">
    {
      ossContributions.map((oss, index) => {
        const count = stars[oss.repo];
        return (
          <Reveal delay={index * 0.05} class="h-full">
            <div class="relative h-full pt-3">
              <Paper tilt={tilts[index % tilts.length]} class="flex h-full flex-col p-4">
                <Pin />
                <div class="flex items-center justify-between gap-2">
                  <span class="flex min-w-0 items-center gap-2">
                    <a
                      href={oss.repoUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="link-ink truncate font-mono text-[11px] font-medium"
                    >
                      {oss.repo}
                    </a>
                    {count != null ? (
                      <span
                        title={`${count.toLocaleString()} stars`}
                        class="inline-flex shrink-0 items-center gap-1 font-mono text-[10px] text-ink-faint"
                      >
                        <Icon name="star" size={11} />
                        {formatStars(count)}
                      </span>
                    ) : null}
                  </span>
                  <span class="inline-flex shrink-0 items-center gap-1 rounded-full bg-green-100 px-2 py-0.5 font-mono text-[10px] font-medium text-green-800">
                    <Icon name="git-pull-request-arrow" size={11} />
                    {oss.pr} {oss.status}
                  </span>
                </div>

                <h3 class="mt-2 text-[14px] leading-snug font-semibold text-ink">{oss.title}</h3>
                <p class="mt-1.5 text-[12.5px] leading-[1.65] text-ink-soft">{oss.impact}</p>

                <a
                  href={oss.prUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="mt-3 inline-flex items-center gap-1 text-[12px] font-medium text-accent-ink transition hover:text-accent"
                >
                  View PR
                  <Icon name="arrow-up-right" size={13} />
                </a>
              </Paper>
            </div>
          </Reveal>
        );
      })
    }
  </div>
</section>
