---
/**
 * Option E — index list. One clean row per project: small framed thumbnail,
 * name, one-liner and stack. The fastest to scan.
 */
import { Picture } from "astro:assets";
import { projects } from "@/content/projects";
import { siteConfig } from "@/content/site";
import { localImage } from "@/lib/images";
import Icon from "@/components/Icon.astro";

const featured = siteConfig.featuredProjects
  .map((slug) => projects.find((project) => project.slug === slug))
  .filter((project) => project !== undefined);
---

<section id="projects" class="scroll-mt-20">
  <h2 class="section-title">Projects</h2>

  <ul class="mt-5 divide-y divide-line border-y border-line">
    {
      featured.map((project, index) => {
        const image = project.image ? localImage(project.image) : undefined;
        const isDownload = project.live?.includes("github.com");
        return (
          <li class="grid grid-cols-[96px_1fr] gap-4 py-5 sm:grid-cols-[180px_1fr_auto] sm:items-center sm:gap-6">
            {image ? (
              <div class="browser overflow-hidden rounded-lg">
                <div class="flex gap-1 border-b border-[var(--frame-line)] px-2 py-1.5" aria-hidden="true">
                  <span class="size-1.5 rounded-full bg-[#ff5f57]" />
                  <span class="size-1.5 rounded-full bg-[#febc2e]" />
                  <span class="size-1.5 rounded-full bg-[#28c840]" />
                </div>
                <Picture
                  src={image}
                  alt={`${project.title} screenshot`}
                  formats={["avif", "webp"]}
                  widths={[200, 360]}
                  sizes="(min-width: 640px) 180px, 96px"
                  loading={index === 0 ? "eager" : "lazy"}
                  class="aspect-[16/10] w-full object-cover object-top"
                />
              </div>
            ) : null}
            <div class="min-w-0">
              <div class="flex flex-wrap items-baseline gap-x-2">
                <h3 class="text-lg font-bold tracking-tight text-text">{project.title}</h3>
                <span class="text-xs font-medium text-text-soft">{project.badge}</span>
              </div>
              <p class="mt-1 text-[15px] text-text-soft">{project.description}</p>
              <p class="mt-2 text-[13px] text-text-soft">{project.stack.slice(0, 4).join(" · ")}</p>
              <div class="mt-3 flex gap-4 text-sm font-semibold sm:hidden">
                {project.live ? <a href={project.live} target="_blank" rel="noopener noreferrer" class="text-accent-text">{isDownload ? "Download" : "Live site"} ↗</a> : null}
                {project.github ? <a href={project.github} target="_blank" rel="noopener noreferrer" class="text-text-soft">Code ↗</a> : null}
              </div>
            </div>
            <div class="hidden flex-col items-end gap-2 sm:flex">
              {project.live ? (
                <a href={project.live} target="_blank" rel="noopener noreferrer" class="btn btn-primary h-9 px-3.5 text-[13px]">
                  {isDownload ? "Download" : "Live"} <Icon name="arrow-up-right" size={14} />
                </a>
              ) : null}
              {project.github ? (
                <a href={project.github} target="_blank" rel="noopener noreferrer" class="btn btn-ghost h-9 px-3.5 text-[13px]">
                  <Icon name="github" size={14} /> Code
                </a>
              ) : null}
            </div>
          </li>
        );
      })
    }
  </ul>
</section>
