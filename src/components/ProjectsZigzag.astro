---
/**
 * Option B — editorial zigzag. Each project is a row: framed screenshot on one
 * side, story on the other, alternating. Text sits directly on the page.
 */
import { projects } from "@/content/projects";
import { siteConfig } from "@/content/site";
import { localImage } from "@/lib/images";
import BrowserFrame from "@/components/BrowserFrame.astro";
import ProjectLinks from "@/components/ProjectLinks.astro";

const featured = siteConfig.featuredProjects
  .map((slug) => projects.find((project) => project.slug === slug))
  .filter((project) => project !== undefined);
---

<section id="projects" class="scroll-mt-20">
  <h2 class="section-title">Projects</h2>

  <div class="mt-8 space-y-14 sm:space-y-20">
    {
      featured.map((project, index) => {
        const image = project.image ? localImage(project.image) : undefined;
        const flip = index % 2 === 1;
        return (
          <article class="grid items-center gap-6 sm:grid-cols-2 sm:gap-10">
            {image ? (
              <div class:list={[flip && "sm:order-2"]}>
                <BrowserFrame
                  image={image}
                  alt={`${project.title} screenshot`}
                  url={project.live?.includes("github.com") ? project.github : (project.live ?? project.github)}
                  eager={index === 0}
                  sizes="(min-width: 640px) 360px, 100vw"
                />
              </div>
            ) : null}

            <div>
              <p class="font-mono text-sm font-semibold text-accent-text">
                {String(index + 1).padStart(2, "0")}
                <span class="ml-2 font-sans font-medium text-text-soft">{project.badge}</span>
              </p>
              <h3 class="mt-2 text-2xl font-bold tracking-tight text-text">{project.title}</h3>
              <p class="mt-1 text-[15px] font-semibold text-accent-text">{project.oneLiner}</p>
              <p class="mt-3 text-[15px] leading-relaxed text-text-soft">{project.description}</p>

              {project.highlights?.length ? (
                <ul class="mt-3 space-y-1.5">
                  {project.highlights.slice(0, 2).map((highlight) => (
                    <li class="flex gap-2 text-[14px] leading-snug text-text">
                      <span aria-hidden="true" class="mt-[7px] size-1.5 shrink-0 rounded-full bg-accent" />
                      {highlight}
                    </li>
                  ))}
                </ul>
              ) : null}

              <ul class="mt-4 flex flex-wrap gap-1.5" aria-label="Built with">
                {project.stack.map((tech) => (
                  <li class="rounded-full border border-line px-2.5 py-0.5 text-xs font-medium text-text-soft">{tech}</li>
                ))}
              </ul>

              <div class="mt-5">
                <ProjectLinks project={project} />
              </div>
            </div>
          </article>
        );
      })
    }
  </div>
</section>
