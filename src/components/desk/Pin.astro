---
const { class: className } = Astro.props as { class?: string };
---

<span
  aria-hidden="true"
  class:list={["absolute top-[-9px] left-1/2 size-[18px] -translate-x-1/2", className]}
>
  <span
    class="absolute inset-0 rounded-full"
    style="background: radial-gradient(circle at 33% 30%, #ff9d6b 0%, var(--accent) 45%, #a8471a 100%); box-shadow: 0 3px 6px rgba(0,0,0,0.45);"
  ></span>
  <span class="absolute top-[3px] left-[4px] size-[5px] rounded-full bg-white/60"></span>
</span>
