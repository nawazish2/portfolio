---
const sections = [
  { id: "about", label: "About" },
  { id: "work", label: "Work" },
  { id: "projects", label: "Projects" },
  { id: "opensource", label: "OSS" },
  { id: "notes", label: "Writing" },
];
---

<div class="fixed inset-x-0 top-3 z-50 flex justify-center px-2 sm:top-5 sm:px-3">
  <nav
    aria-label="Sections"
    class="flex max-w-full items-center gap-0 overflow-x-auto rounded-full border border-white/12 bg-[var(--chrome)] p-1 shadow-[0_10px_30px_-12px_rgba(0,0,0,0.8)] [scrollbar-width:none] sm:gap-1 [&::-webkit-scrollbar]:hidden"
  >
    {
      sections.map((section) => (
        <a
          href={`#${section.id}`}
          data-nav={section.id}
          class="shrink-0 rounded-full px-2 py-1.5 text-[11px] font-medium whitespace-nowrap text-on-mat-soft transition-colors hover:text-on-mat data-[active]:bg-white/12 data-[active]:text-on-mat sm:px-4 sm:text-[14px]"
        >
          {section.label}
        </a>
      ))
    }
    <a
      href="#contact"
      class="ml-0.5 inline-flex shrink-0 items-center gap-1.5 rounded-full bg-accent px-2.5 py-1.5 text-[11px] font-semibold whitespace-nowrap text-white transition hover:brightness-110 sm:px-4 sm:text-[14px]"
    >
      <span aria-hidden="true" class="size-1.5 animate-pulse rounded-full bg-white"></span>
      Connect
    </a>
  </nav>
</div>

<script>
  const links = new Map<string, HTMLElement>();
  for (const link of document.querySelectorAll<HTMLElement>("[data-nav]")) {
    links.set(link.dataset.nav!, link);
  }

  const observer = new IntersectionObserver(
    (entries) => {
      const visible = entries
        .filter((entry) => entry.isIntersecting)
        .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];
      if (!visible) return;
      for (const [id, link] of links) {
        link.toggleAttribute("data-active", id === visible.target.id);
      }
    },
    { rootMargin: "-45% 0px -50% 0px" },
  );

  for (const id of links.keys()) {
    const el = document.getElementById(id);
    if (el) observer.observe(el);
  }
</script>
