---
/** Section heading that sits directly on the mat, with a handwritten second half. */
interface Props {
  hand?: string;
  class?: string;
}
const { hand, class: className } = Astro.props;
---

<div class:list={["flex items-end gap-2.5", className]}>
  <h2 class="mat-title">
    <slot />
    {
      hand ? (
        <>
          {" "}
          <span class="font-hand text-[1.08em] leading-none font-normal text-accent-soft">{hand}</span>
        </>
      ) : null
    }
  </h2>
</div>
