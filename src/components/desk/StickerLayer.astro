---
import { siteConfig } from "@/content/site";
import Icon from "@/components/Icon.astro";

/**
 * Draggable stickers in the page gutters. Only shown from `xl` up — the first
 * width with a gutter wide enough, and below it a draggable element fights
 * touch scrolling. Plain pointer events + transforms: no animation library.
 */
const spots = [
  { top: "13%", left: "12px", tilt: -9 },
  { top: "31%", right: "14px", tilt: 8 },
  { top: "52%", left: "16px", tilt: 6 },
  { top: "68%", right: "12px", tilt: -7 },
  { top: "85%", left: "14px", tilt: 4 },
];
---

<div class="pointer-events-none absolute inset-0 z-30 hidden xl:block" data-stickers>
  {
    siteConfig.stickers.map((sticker, index) => {
      const spot = spots[index % spots.length];
      return (
        <div
          aria-hidden="true"
          data-sticker={index}
          class="pointer-events-auto absolute cursor-grab touch-none select-none active:cursor-grabbing"
          style={{ top: spot.top, left: spot.left, right: spot.right }}
        >
          <div
            data-face
            class="flex w-[96px] flex-col items-center gap-1 rounded-2xl px-2.5 py-2.5 text-center transition-transform duration-150"
            style={{
              transform: `rotate(${spot.tilt}deg)`,
              background: "linear-gradient(180deg, #fbf7ef, #ece5d5)",
              boxShadow: "0 1px 2px rgba(0,0,0,0.3), 0 12px 22px -12px rgba(0,0,0,0.75)",
            }}
          >
            <span class="text-[24px] leading-none">{sticker.emoji}</span>
            <span class="font-hand text-[14px] leading-tight text-ink-soft">{sticker.label}</span>
          </div>
        </div>
      );
    })
  }

  <button
    type="button"
    data-sticker-reset
    hidden
    class="pointer-events-auto fixed bottom-5 left-5 z-40 inline-flex items-center gap-1.5 rounded-full border border-white/12 bg-[var(--chrome)] px-3.5 py-2 font-hand text-[16px] text-on-mat-soft transition hover:text-on-mat"
  >
    <Icon name="rotate-ccw" size={13} />
    put the stickers back
  </button>
</div>

<script>
  type Offset = { x: number; y: number };

  const STORAGE_KEY = "desk-stickers-v1";
  const bounds = { left: -160, right: 160, top: -260, bottom: 260 };
  const elastic = 0.12;

  const layer = document.querySelector<HTMLElement>("[data-stickers]");
  const desktop = window.matchMedia("(min-width: 80rem)");
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  if (layer && desktop.matches && !reduceMotion.matches) {
    const reset = layer.querySelector<HTMLButtonElement>("[data-sticker-reset]")!;
    let offsets: Record<string, Offset> = {};
    try {
      offsets = JSON.parse(localStorage.getItem(STORAGE_KEY) ?? "{}") as Record<string, Offset>;
    } catch {
      // a blocked or corrupt store just means the stickers start at rest
    }

    const save = () => {
      try {
        if (Object.keys(offsets).length) localStorage.setItem(STORAGE_KEY, JSON.stringify(offsets));
        else localStorage.removeItem(STORAGE_KEY);
      } catch {
        // ignore
      }
      reset.hidden = Object.keys(offsets).length === 0;
    };

    /** Past the bounds the sticker follows the pointer at a fraction, like a rubber band. */
    const rubber = (value: number, min: number, max: number) =>
      value < min ? min + (value - min) * elastic : value > max ? max + (value - max) * elastic : value;
    const clamp = (value: number, min: number, max: number) => Math.min(max, Math.max(min, value));

    const stickers = [...layer.querySelectorAll<HTMLElement>("[data-sticker]")];

    const place = (el: HTMLElement, offset: Offset, animate: boolean) => {
      el.style.transition = animate ? "transform 260ms cubic-bezier(0.2, 0.8, 0.2, 1)" : "";
      el.style.transform = `translate3d(${offset.x}px, ${offset.y}px, 0)`;
    };

    for (const el of stickers) {
      const id = el.dataset.sticker!;
      const face = el.querySelector<HTMLElement>("[data-face]")!;
      const restTilt = face.style.transform;
      if (offsets[id]) place(el, offsets[id], false);

      let start: { px: number; py: number; x: number; y: number } | null = null;

      el.addEventListener("pointerdown", (event) => {
        const current = offsets[id] ?? { x: 0, y: 0 };
        start = { px: event.clientX, py: event.clientY, x: current.x, y: current.y };
        el.setPointerCapture(event.pointerId);
        el.style.zIndex = "40";
        el.style.willChange = "transform";
        face.style.transform = "rotate(0deg) scale(1.08)";
      });

      el.addEventListener("pointermove", (event) => {
        if (!start) return;
        place(
          el,
          {
            x: rubber(start.x + event.clientX - start.px, bounds.left, bounds.right),
            y: rubber(start.y + event.clientY - start.py, bounds.top, bounds.bottom),
          },
          false,
        );
      });

      const end = (event: PointerEvent) => {
        if (!start) return;
        const next = {
          x: clamp(start.x + event.clientX - start.px, bounds.left, bounds.right),
          y: clamp(start.y + event.clientY - start.py, bounds.top, bounds.bottom),
        };
        start = null;
        offsets[id] = next;
        place(el, next, true);
        face.style.transform = restTilt;
        el.style.zIndex = "";
        el.style.willChange = "";
        save();
      };
      el.addEventListener("pointerup", end);
      el.addEventListener("pointercancel", end);
    }

    reset.addEventListener("click", () => {
      offsets = {};
      for (const el of stickers) place(el, { x: 0, y: 0 }, true);
      save();
    });

    reset.hidden = Object.keys(offsets).length === 0;
  }
</script>
