---
import { siteConfig } from "@/content/site";

const stack = siteConfig.featuredStack
  .map((name) => siteConfig.stack.find((item) => item.name === name))
  .filter((item) => item !== undefined);

const order = ["Frontend", "Backend", "Native", "Tools", "AI"];
const groups = order
  .map((category) => ({ category, items: stack.filter((item) => item.category === category) }))
  .filter((group) => group.items.length > 0);
---

<section id="stack" class="scroll-mt-20">
  <h2 class="section-title">Tech stack</h2>
  <dl class="mt-4 space-y-2.5">
    {
      groups.map((group) => (
        <div class="sm:flex sm:items-baseline sm:gap-4">
          <dt class="w-20 shrink-0 text-xs font-semibold tracking-wide text-text-soft uppercase">{group.category}</dt>
          <dd class="mt-1.5 flex flex-wrap gap-1.5 sm:mt-0">
            {group.items.map((item) => (
              <span class="inline-flex items-center gap-2 rounded-full border border-line bg-bg-raised px-3 py-1 text-sm font-medium text-text">
                <span aria-hidden="true" class="size-2 rounded-full" style={{ backgroundColor: item.color === "#000000" || item.color === "#181717" ? "var(--text)" : item.color }} />
                {item.name}
              </span>
            ))}
          </dd>
        </div>
      ))
    }
  </dl>
</section>
