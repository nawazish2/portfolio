---
/**
 * A + E mix. The two strongest projects get large cards with a framed
 * screenshot; the rest follow as compact list rows.
 */
import { Picture } from "astro:assets";
import { projects } from "@/content/projects";
import { siteConfig } from "@/content/site";
import { localImage } from "@/lib/images";
import BrowserFrame from "@/components/BrowserFrame.astro";
import ProjectLinks from "@/components/ProjectLinks.astro";
import Icon from "@/components/Icon.astro";

const featured = siteConfig.featuredProjects
  .map((slug) => projects.find((project) => project.slug === slug))
  .filter((project) => project !== undefined);
const big = featured.slice(0, 2);
const rest = featured.slice(2);
---

<section id="projects" class="scroll-mt-20">
  <h2 class="section-title">Projects</h2>

  <div class="mt-5 space-y-5">
    {
      big.map((project, index) => {
        const image = project.image ? localImage(project.image) : undefined;
        return (
          <article class="card overflow-hidden p-3 sm:p-4">
            {image ? (
              <BrowserFrame
                image={image}
                alt={`${project.title} screenshot`}
                url={project.live?.includes("github.com") ? project.github : (project.live ?? project.github)}
                eager={index === 0}
                sizes="(min-width: 768px) 736px, 100vw"
              />
            ) : null}
            <div class="grid gap-4 px-1 pt-4 pb-1 sm:grid-cols-[1fr_1fr] sm:gap-6 sm:px-2">
              <div>
                <p class="text-xs font-semibold tracking-wide text-ink-faint uppercase">{project.badge}</p>
                <h3 class="mt-1 text-2xl font-bold tracking-tight">{project.title}</h3>
                <p class="mt-1 text-[15px] font-semibold text-accent-ink">{project.oneLiner}</p>
                <p class="mt-2 text-[15px] leading-relaxed text-ink-soft">{project.description}</p>
              </div>
              <div class="flex flex-col">
                {project.highlights?.length ? (
                  <ul class="space-y-2">
                    {project.highlights.slice(0, 2).map((highlight) => (
                      <li class="flex gap-2 text-[14px] leading-snug text-ink">
                        <span aria-hidden="true" class="mt-[7px] size-1.5 shrink-0 rounded-full bg-accent" />
                        {highlight}
                      </li>
                    ))}
                  </ul>
                ) : null}
                <p class="mt-3 text-[13px] text-ink-faint">{project.stack.join(" · ")}</p>
                <div class="mt-4 sm:mt-auto sm:pt-4">
                  <ProjectLinks project={project} tone="card" />
                </div>
              </div>
            </div>
          </article>
        );
      })
    }

  </div>

  {
    rest.length ? (
      <>
        <h3 class="mt-10 text-sm font-semibold tracking-wide text-text-soft uppercase">More projects</h3>
        <ul class="mt-3 divide-y divide-line border-y border-line">
          {rest.map((project) => {
            const image = project.image ? localImage(project.image) : undefined;
            const isDownload = project.live?.includes("github.com");
            return (
              <li class="grid grid-cols-[96px_1fr] gap-4 py-5 sm:grid-cols-[180px_1fr_auto] sm:items-center sm:gap-6">
                {image ? (
                  <div class="browser overflow-hidden rounded-lg">
                    <div class="flex gap-1 border-b border-[var(--frame-line)] px-2 py-1.5" aria-hidden="true">
                      <span class="size-1.5 rounded-full bg-[#ff5f57]" />
                      <span class="size-1.5 rounded-full bg-[#febc2e]" />
                      <span class="size-1.5 rounded-full bg-[#28c840]" />
                    </div>
                    <Picture
                      src={image}
                      alt={`${project.title} screenshot`}
                      formats={["avif", "webp"]}
                      widths={[200, 360]}
                      sizes="(min-width: 640px) 180px, 96px"
                      loading="lazy"
                      class="aspect-[16/10] w-full object-cover object-top"
                    />
                  </div>
                ) : null}
                <div class="min-w-0">
                  <div class="flex flex-wrap items-baseline gap-x-2">
                    <h4 class="text-lg font-bold tracking-tight text-text">{project.title}</h4>
                    <span class="text-xs font-medium text-text-soft">{project.badge}</span>
                  </div>
                  <p class="mt-1 text-[15px] text-text-soft">{project.description}</p>
                  <p class="mt-2 text-[13px] text-text-soft">{project.stack.slice(0, 4).join(" · ")}</p>
                  <div class="mt-3 flex gap-4 text-sm font-semibold sm:hidden">
                    {project.live ? <a href={project.live} target="_blank" rel="noopener noreferrer" class="text-accent-text">{isDownload ? "Download" : "Live site"} ↗</a> : null}
                    {project.github ? <a href={project.github} target="_blank" rel="noopener noreferrer" class="text-text-soft">Code ↗</a> : null}
                  </div>
                </div>
                <div class="hidden flex-col items-end gap-2 sm:flex">
                  {project.live ? (
                    <a href={project.live} target="_blank" rel="noopener noreferrer" class="btn btn-primary h-9 px-3.5 text-[13px]">
                      {isDownload ? "Download" : "Live"} <Icon name="arrow-up-right" size={14} />
                    </a>
                  ) : null}
                  {project.github ? (
                    <a href={project.github} target="_blank" rel="noopener noreferrer" class="btn btn-ghost h-9 px-3.5 text-[13px]">
                      <Icon name="github" size={14} /> Code
                    </a>
                  ) : null}
                </div>
              </li>
            );
          })}
        </ul>
      </>
    ) : null
  }
</section>
