---
import { Picture } from "astro:assets";
import type { Project } from "@/content/projects";
import { localImage } from "@/lib/images";
import Icon from "@/components/Icon.astro";
import Paper from "@/components/desk/Paper.astro";
import Pin from "@/components/desk/Pin.astro";
import Reveal from "@/components/Reveal.astro";

/** Small, fixed tilts so the wall of cards looks pinned by hand, not randomised. */
const tilts = [-1.4, 1.1, 0.9, -1.2, -0.8, 1.3];

interface Props {
  project: Project;
  index: number;
}
const { project, index } = Astro.props;
const primaryStack = project.stack.slice(0, 3);
const image = project.image ? localImage(project.image) : undefined;
const iconLink =
  "flex size-7 items-center justify-center rounded-full border border-paper-edge text-ink-soft transition hover:bg-paper-sunk hover:text-ink";
---

<Reveal delay={index * 0.05}>
  <div class="relative pt-3 transition-transform duration-300 hover:-translate-y-1">
    <Paper tilt={tilts[index % tilts.length]} class="flex h-full flex-col p-2 pb-3">
      <Pin />

      <div class="relative aspect-[16/8] overflow-hidden rounded-[5px] bg-paper-sunk">
        {
          image ? (
            <Picture
              src={image}
              alt={`${project.title} screenshot`}
              formats={["avif", "webp"]}
              widths={[400, 640, 900]}
              sizes="(min-width: 896px) 420px, (min-width: 640px) 46vw, 92vw"
              loading="lazy"
              decoding="async"
              class="absolute inset-0 h-full w-full object-cover"
            />
          ) : (
            <div class="flex h-full items-center justify-center px-4 text-center font-hand text-[18px] text-ink-soft">
              {project.oneLiner}
            </div>
          )
        }
      </div>

      <div class="px-1 pt-2">
        <div class="flex items-baseline justify-between gap-2">
          <h3 class="text-[14px] leading-none font-semibold tracking-tight text-ink">{project.title}</h3>
          <span class="font-mono text-[10px] text-ink-faint">{project.year}</span>
        </div>

        <p class="mt-1 truncate font-mono text-[10px] tracking-wide text-ink-faint">{primaryStack.join(" · ")}</p>

        <p class="mt-1 font-hand text-[14.5px] leading-tight text-accent-ink">
          {project.badge ? `${project.badge} · ` : ""}{project.oneLiner}
        </p>

        <p class="mt-1.5 line-clamp-2 text-[12.5px] leading-[1.65] text-ink-soft">{project.description}</p>

        {
          project.metric ? (
            <p class="mt-1.5 inline-block rounded-full bg-paper-sunk px-2 py-0.5 font-mono text-[10px] leading-relaxed text-ink">
              {project.metric}
            </p>
          ) : null
        }

        <div class="mt-2.5 flex items-center gap-2">
          {
            project.github ? (
              <a
                href={project.github}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${project.title} on GitHub`}
                class={iconLink}
              >
                <Icon name="github" size={14} />
              </a>
            ) : null
          }
          {
            project.live ? (
              <a
                href={project.live}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${project.title} live link`}
                class={iconLink}
              >
                <Icon name="external-link" size={14} />
              </a>
            ) : null
          }
          <span class="ml-auto font-mono text-[10px] tracking-wider text-ink-faint uppercase">{project.status}</span>
        </div>
      </div>
    </Paper>
  </div>
</Reveal>
