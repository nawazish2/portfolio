{
  "name": "portfolio",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --bun astro dev",
    "build": "bun --bun astro build",
    "preview": "bun --bun astro build && bun --bun wrangler dev",
    "typecheck": "bun --bun wrangler types && bun --bun tsc --noEmit",
    "deploy": "bun --bun astro build && bun --bun wrangler deploy"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.6",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/inter": "^5.3.0",
    "astro": "^7.4.7",
    "resend": "^6.37.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "lucide-static": "^1.70.0",
    "satori": "^0.63.2",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.4",
    "typescript": "^5.9.3",
    "wrangler": "^4.158.0"
  },
  "trustedDependencies": [
    "esbuild",
    "sharp",
    "workerd"
  ]
}
